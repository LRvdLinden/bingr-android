<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Herinneringen (Reminders): exact alarm als het mag, anders valt de code terug op een gewoon alarm -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Downloads op Android 7–13: WorkManager-voorgronddienst zonder type (met voortgangsmelding) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- build 97: FOREGROUND_SERVICE_MEDIA_PLAYBACK weg (er is geen voorgronddienst voor afspelen) -->
    <!-- build 141: FOREGROUND_SERVICE_DATA_SYNC weg. Downloads op Android 14+ zijn een door de gebruiker gestarte
         gegevensoverdracht (DownloadJobService, JobScheduler setUserInitiated); daar is geen voorgronddienst voor nodig -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Werkt op telefoon/tablet én Android TV / Google TV / Fire TV -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".BingrApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Bingr"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/Theme.Bingr">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Bingr">
            <!-- TV-launcher; op telefoon/tablet staat het icoon op een van de activity-aliassen hieronder (build 52) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Pushmeldingen (docs/PUSH.md in iptv-ios-appletv): bingr://changelog?p=&b= en bingr://live?channel=&profile= -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bingr" android:host="changelog" />
                <data android:scheme="bingr" android:host="live" />
                <!-- build 120: titel uit een e-mail van Bingr (fallbackknop op bingr.online/titel/) -->
                <data android:scheme="bingr" android:host="title" />
            </intent-filter>
            <!-- Build 120: app link uit de e-mail van Bingr: https://bingr.online/titel/?type=&id=&q=&y=
                 (geverifieerd via https://bingr.online/.well-known/assetlinks.json; eigen filter, zodat autoVerify alleen
                 voor bingr.online geldt) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="bingr.online" />
                <data android:pathPrefix="/titel" />
            </intent-filter>
        </activity>

        <!-- App-icoon kiezen (Instellingen > Uiterlijk): precies één alias staat aan -->
        <activity-alias
            android:name=".LauncherDefault"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:label="Bingr">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherDark"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_dark"
            android:roundIcon="@mipmap/ic_launcher_dark"
            android:label="Bingr">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherLight"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_light"
            android:roundIcon="@mipmap/ic_launcher_light"
            android:label="Bingr">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherBlue"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_blue"
            android:roundIcon="@mipmap/ic_launcher_blue"
            android:label="Bingr">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherGold"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_gold"
            android:roundIcon="@mipmap/ic_launcher_gold"
            android:label="Bingr">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- WorkManager-voorgronddienst voor downloads (alleen Android 13 en ouder, zonder type; build 141: geen dataSync meer) -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:remove="android:foregroundServiceType"
            tools:node="merge" />
        <!-- build 141: downloads op Android 14+ (door de gebruiker gestarte gegevensoverdracht) -->
        <service
            android:name=".DownloadJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- Pushmeldingen (FCM): alleen actief als de build een google-services.json had (anders start Firebase niet) -->
        <service
            android:name=".BingrMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- geen token vanzelf: pas na inloggen, met toestemming en alleen op telefoon/tablet (Push.sync) -->
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <!-- melding met een notification-blok terwijl de app niet draait: kanaal "Berichten" en het Bingr-icoon -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="messages" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_bingr" />

        <receiver android:name=".ReminderReceiver" android:exported="false" />
        <!-- Herinneringen opnieuw plannen na een herstart (alarmen overleven dat niet) -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="nl.lrvdlinden.bingr.CastOptionsProvider" />
    </application>
</manifest>
