<?xml version="1.0" encoding="utf-8"?>
<!--
    build 97: Google-back-up tot en met Android 11 (android:fullBackupContent).
    Build 145: geen Google-back-up meer (android:allowBackup="false"); alles wat bij de gebruiker hoort (servers,
    profielen, pincodes, Mijn lijst, kijkvoortgang, categorieën en instellingen) komt alleen via het Bingr-account terug
    (docs/ACCOUNT.md). Wat alleen op dit apparaat hoort (sessie, device_id, geheimen, caches en de keuze "Servers laden bij
    openen") gaat nergens heen. Voor de zekerheid sluiten deze regels ook alles uit.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
