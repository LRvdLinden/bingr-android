<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Bingr" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:colorAccent">#E50914</item>
    </style>
    <!-- build 174: zenderknop in de widget "Bingr Radio" -->
    <style name="RadioWidgetStation">
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/widget_radio_station</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
